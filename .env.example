# === SIBERSIH-STTR Environment Variables ===
# Salin file ini menjadi `.env` dan isi dengan nilai yang sesuai.

# Supabase Project URL (aman untuk frontend)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (aman untuk frontend, dilindungi oleh RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (RAHASIA — JANGAN gunakan prefix VITE_!)
# Key ini hanya boleh diakses di server-side (Edge Functions / API Routes).
# TIDAK akan ter-bundle ke browser karena tanpa prefix VITE_.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
