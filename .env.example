# === SIBERSIH-STTR Environment Variables ===
# Salin file ini menjadi `.env` dan isi dengan nilai yang sesuai.

# Supabase Project URL (aman untuk frontend, ter-bundle oleh Vite)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (aman untuk frontend, dilindungi oleh RLS)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (RAHASIA — server-side only!)
# Key ini TIDAK menggunakan prefix VITE_ sehingga TIDAK ter-bundle ke browser.
# Hanya diakses oleh Vercel Serverless Functions (folder /api) via process.env.
# Di Vercel Dashboard: Settings → Environment Variables → tambahkan key ini.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
